# ─────────────────────────────────────────────
# ImpedeX — environment template
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@127.0.0.1:5432/eips

# Secret for signing JWTs — use a long random hex string,
# MUST be identical on the student server (:4000) and admin server (:4001)
EIPS_JWT_SECRET=

# Exactly 32 bytes (any string) used to encrypt fingerprint templates at rest
EIPS_ENCRYPTION_KEY=

# Ports
PORT=4000
ADMIN_PORT=4001

# Comma-separated origins allowed to call the local scanner bridge
ZKBRIDGE_ORIGINS=http://localhost:4000

# Cookie domain (optional)
# COOKIE_DOMAIN=

# Email delivery (optional — emails are logged to console while unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=ImpedeX <noreply@impedex.edu.ng>
